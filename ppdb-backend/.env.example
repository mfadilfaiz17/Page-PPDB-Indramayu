# Konfigurasi Database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=sistem_ppdb
DB_PORT=3306

# Konfigurasi JWT
JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_EXPIRES_IN=7d

# Konfigurasi Server
PORT=5000

# Konfigurasi Email (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_app_specific_password_here

# Email Settings
EMAIL_FROM_NAME=PPDB Indramayu
FRONTEND_URL=http://localhost:5173

# Token Expiration
VERIFICATION_TOKEN_EXPIRES=24h
PASSWORD_RESET_TOKEN_EXPIRES=1h
