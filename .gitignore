# ============================================
# PPDB Indramayu - .gitignore
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
*/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Environment Variables (SECURITY CRITICAL)
# ============================================
# Never commit .env files with secrets!
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test.local
.env.production.local
ppdb-backend/.env
ppdb-app/.env

# Keep .env.example for reference
!.env.example
!ppdb-backend/.env.example
!ppdb-app/.env.example

# ============================================
# Build Outputs
# ============================================
dist/
build/
*/dist/
*/build/
ppdb-app/dist/
ppdb-backend/dist/
.next/
out/

# ============================================
# Uploads & User Generated Files
# ============================================
# Don't track uploaded files (contains user data)
ppdb-backend/uploads/*
!ppdb-backend/uploads/.gitkeep

# Temporary files
*.tmp
*.temp
temp/
tmp/

# ============================================
# Logs
# ============================================
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Backend logs
ppdb-backend/*.log
ppdb-backend/logs/

# Frontend logs
ppdb-app/*.log
ppdb-app/logs/

# ============================================
# Testing & Coverage
# ============================================
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ============================================
# OS Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# IDE & Editors
# ============================================
# VSCode
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc)
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
*~
.*.sw?

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# ============================================
# Package Manager
# ============================================
.npm/
.yarn/
.pnp.*
.yarn-integrity

# ============================================
# Database
# ============================================
# SQLite
*.sqlite
*.sqlite3
*.db

# MySQL dumps (if any)
*.sql.gz
backup/
backups/

# ============================================
# Cache & Temporary
# ============================================
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm
.yarn
.pnp
.pnp.js

# Vite
.vite/
vite.config.js.timestamp-*

# ============================================
# Security & Certificates
# ============================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
credentials/

# ============================================
# Documentation (Optional - Keep if needed)
# ============================================
# Uncomment if you don't want to track these
# PHASE1_COMPLETION_REPORT.md
# PHASE2_PROGRESS_REPORT.md
# TESTING_GUIDE.md

# ============================================
# Misc
# ============================================
.vercel
.netlify
.firebase/
.serverless/

# Lock files (optional - uncomment if you want to ignore)
# package-lock.json
# yarn.lock

# ============================================
# Project Specific
# ============================================
# Cleanup scripts output
cleanup-*.log

# Migration backups
migrations/backup/

# Email service test files
email-test-*.html

# ============================================
# Dokumentasi PPDB yang Dibuang dari GitHub
# ============================================
AGENTS.md